//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 3>, <&mo 0>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&to 0>, <&to 5>;
        };

        // Customed Hold-Tap for SandS

        slayer: slayer {
            compatible = "zmk,behavior-tap-dance";
            label = "SLAYER";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&mo 2>;

            tapping-term-ms = <100>;
        };

        CandL: CandL {
            compatible = "zmk,behavior-tap-dance";
            label = "CANDL";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_CONTROL>, <&mo 2>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 0>;

            label = "MKP_EXIT_AML";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        JP {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <36 35>;
            timeout-ms = <20>;
        };

        EN {
            bindings = <&kp RA(GRAVE)>;
            key-positions = <45 46>;
            timeout-ms = <20>;
        };

        single {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <75 48>;
        };

        studiounlock {
            bindings = <&studio_unlock>;
            key-positions = <51 52 53 54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC       &kp F1      &kp F2  &kp F3            &kp F4           &kp F5                                   &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                             &kp F6       &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&kp GRAVE     &kp Q       &kp L   &kp U             &kp COMMA        &kp PERIOD                               &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                           &kp F        &kp W   &kp R   &kp Y   &kp P    &kp F12
&kp TAB       &kp E       &kp I   &kp A             &kp O            &kp MINUS               &kp PAGE_UP      &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp LBKT               &kp K        &kp T   &kp N   &kp S   &kp H    &kp ENTER
&kp LSHFT     &kp Z       &kp X   &kp C             &kp V            &kp SEMICOLON           &kp PAGE_DOWN    &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RBKT               &kp G        &kp D   &kp M   &kp J   &kp B    &kp RIGHT_SHIFT
&kp LEFT_WIN  &kp C_MUTE          &kp LEFT_CONTROL  &lt 2 BACKSPACE  &mt LEFT_CONTROL ENTER  &kp LEFT_ALT                                                             &mt RIGHT_CONTROL TAB  &lt 3 SPACE                                   &td1
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&to_layer_0 ESC     &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                     &trans  &trans  &trans  &trans                     &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8  &to_layer_0 N9      &to_layer_0 N0            &to_layer_0 MINUS
&to_layer_0 TAB     &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                      &trans  &trans  &trans  &trans                     &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I   &to_layer_0 O       &to_layer_0 P             &to_layer_0 EQUAL
&to_layer_0 CAPS    &to_layer_0 A   &mkp RCLK       &mkp MCLK       &mkp LCLK       &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &msc SCRL_UP    &mkp LCLK       &mkp MCLK       &mkp RCLK           &to_layer_0 SINGLE_QUOTE  &to_layer_0 SEMICOLON
&to_layer_0 LSHIFT  &to_layer_0 Z   &to_layer_0 X   &mkp MB4        &mkp MB5        &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &msc SCRL_RIGHT  &msc SCRL_DOWN  &mkp MB4        &mkp MB5        &to_layer_0 PERIOD  &to_layer_0 SLASH         &lt 2 BACKSLASH
&trans              &trans                          &trans          &trans          &trans          &trans                                               &trans           &trans                                                                                        &trans
            >;
        };

        math {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans     &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                   &trans  &trans  &trans  &trans              &trans          &kp LEFT_PARENTHESIS  &trans        &kp RIGHT_PARENTHESIS  &trans         &trans
&trans     &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp HOME                 &trans  &trans  &trans  &trans              &kp CARET       &kp LESS_THAN         &kp EQUAL     &kp GREATER_THAN       &trans         &none
&kp TILDE  &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD  &kp PG_UP    &trans  &trans  &trans  &trans    &kp LPAR  &kp UNDERSCORE  &kp PLUS              &kp MINUS     &kp ASTERISK           &kp SLASH      &kp PERCENT
&trans     &kp DOLLAR    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp END     &kp PG_DN    &trans  &trans  &trans  &trans    &kp RPAR  &trans          &kp EXCLAMATION       &kp QUESTION  &kp COLON              &kp SEMICOLON  &none
&trans     &kp RSHFT                   &trans        &trans        &trans      &trans                                         &trans    &trans                                                                                    &studio_unlock
            >;
        };

        navi {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans       &trans         &trans                &trans             &trans                 &trans                             &trans  &trans  &trans  &trans                   &none         &none       &none            &none          &none           &none
&trans       &none          &kp LEFT_BRACKET      &kp DOUBLE_QUOTES  &kp RIGHT_BRACKET      &kp AMPERSAND                      &trans  &trans  &trans  &trans                   &kp LC(LEFT)  &kp END     &kp HOME         &kp LC(RIGHT)  &kp LC(DELETE)  &none
&kp AT_SIGN  &kp HASH       &kp LEFT_PARENTHESIS  &kp SINGLE_QUOTE   &kp RIGHT_PARENTHESIS  &kp PIPE        &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp BACKSPACE  &kp LEFT      &kp DOWN    &kp UP           &kp RIGHT      &kp DELETE      &kp PRINTSCREEN
&trans       &kp BACKSLASH  &kp LEFT_BRACE        &kp GRAVE          &kp RIGHT_BRACE        &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN      &kp END       &kp C_PREV  &kp PAUSE_BREAK  &kp C_NEXT     &kp RIGHT_ALT   &none
&trans       &none                                &trans             &trans                 &trans          &trans                                               &trans         &trans                                                                    &trans
            >;
        };

        system {
            bindings = <
&trans  &trans        &trans        &trans        &trans          &trans            &trans  &trans  &trans  &trans            &out OUT_TOG  &trans      &trans    &trans         &trans     &trans
&trans  &trans        &bt BT_SEL 4  &bt BT_CLR    &bt BT_CLR_ALL  &mo 5             &trans  &trans  &trans  &trans            &mo 0         &kp INSERT  &kp HOME  &kp PAGE_UP    &trans     &trans
&kp F1  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &kp F6  &trans    &trans  &trans  &trans  &trans    &trans  &kp F7        &kp DELETE  &kp END   &kp PAGE_DOWN  &kp K_APP  &kp F12
&trans  &kp F2        &kp F3        &kp F4        &kp F5          &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans        &kp F8      &kp F9    &kp F10        &kp F11    &trans
&trans  &trans                      &trans        &trans          &trans  &trans                                      &trans  &trans                                                        &trans
            >;
        };

        game {
            bindings = <
&kp ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4      &kp NUMBER_5                   &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE       &kp Q         &kp W         &kp E           &kp R             &kp T                          &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB         &kp A         &kp S         &kp D           &kp F             &kp G         &kp BACKSPACE    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C           &kp V             &kp B         &kp ENTER        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT
&kp LEFT_WIN    &trans                      &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp SPACE     &kp LEFT_ALT                                       &trans  &trans                                  &trans
            >;

            sensor-bindings = <&scroll_down_up>;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
